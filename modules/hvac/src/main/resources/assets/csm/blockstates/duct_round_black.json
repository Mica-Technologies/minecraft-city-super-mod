{
  "multipart": [
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "csm:hvac/exposed/duct_round_black_arm"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "csm:hvac/exposed/duct_round_black_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "csm:hvac/exposed/duct_round_black_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "csm:hvac/exposed/duct_round_black_arm",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "csm:hvac/exposed/duct_round_black_arm",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "csm:hvac/exposed/duct_round_black_arm",
        "x": 90
      }
    },
    {
      "when": {
        "east": "false",
        "west": "false",
        "up": "false",
        "down": "false"
      },
      "apply": {
        "model": "csm:hvac/exposed/duct_round_black_middle"
