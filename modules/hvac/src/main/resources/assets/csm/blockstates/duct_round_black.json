        "up": "false",
        "down": "false"
      },
      "apply": {
        "model": "csm:hvac/exposed/duct_round_black_middle",
        "y": 90
      }
    },
    {
      "when": {
        "north": "false",
        "south": "false",
        "east": "false",
        "west": "false"
      },
      "apply": {
        "model": "csm:hvac/exposed/duct_round_black_middle",
        "x": 90
      }
    },
    {
      "when": {
        "OR": [
          {
            "north": "true",
            "east": "true"
          },
          {
            "north": "true",
            "west": "true"
          },
          {
            "south": "true",
            "east": "true"
          },
          {
            "south": "true",
            "west": "true"
          },
          {
            "north": "true",
            "up": "true"
          },
          {
            "north": "true",
            "down": "true"
          },
          {
            "south": "true",
            "up": "true"
          },
          {
            "south": "true",
            "down": "true"
          },
          {
            "east": "true",
            "up": "true"
          },
          {
            "east": "true",
            "down": "true"
          },
          {
            "west": "true",
            "up": "true"
          },
          {
            "west": "true",
            "down": "true"
          }
        ]
      },
      "apply": {
        "model": "csm:hvac/exposed/duct_round_black_joint"
      }
    },
    {
      "when": {
        "rod": "true"
      },
      "apply": {
        "model": "csm:hvac/exposed/duct_round_black_rod"
      }
    },
    {
      "when": {
        "rod": "true",
        "east": "false",
        "west": "false"
      },
      "apply": {
        "model": "csm:hvac/exposed/duct_round_black_strap"
      }
    },
    {
      "when": {
        "rod": "true",
        "north": "false",
        "south": "false"
      },
      "apply": {
        "model": "csm:hvac/exposed/duct_round_black_strap",
        "y": 90
      }
