{
  "multipart": [
    {
      "apply": {
        "model": "csm:parks/landscape/raised_bed_concrete_post"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "csm:parks/landscape/raised_bed_concrete_side"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "csm:parks/landscape/raised_bed_concrete_side",
        "y": 90,
        "uvlock": false
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "csm:parks/landscape/raised_bed_concrete_side",
        "y": 180,
        "uvlock": false
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "csm:parks/landscape/raised_bed_concrete_side",
        "y": 270,
        "uvlock": false
      }
    }
  ]
}
