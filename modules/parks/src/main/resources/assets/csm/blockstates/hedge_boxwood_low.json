{
  "multipart": [
    {
      "apply": {
        "model": "csm:parks/landscape/hedge_boxwood_low_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "csm:parks/landscape/hedge_boxwood_low_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "csm:parks/landscape/hedge_boxwood_low_side",
        "y": 90,
        "uvlock": false
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "csm:parks/landscape/hedge_boxwood_low_side",
        "y": 180,
        "uvlock": false
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "csm:parks/landscape/hedge_boxwood_low_side",
        "y": 270,
        "uvlock": false
      }
    }
  ]
}
