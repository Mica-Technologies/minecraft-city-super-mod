{
  "multipart": [
    {
      "apply": {
        "model": "csm:parks/amenities/pergola_top_post"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "csm:parks/amenities/pergola_top_side"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "csm:parks/amenities/pergola_top_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "csm:parks/amenities/pergola_top_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "csm:parks/amenities/pergola_top_side",
        "y": 270
      }
    }
  ]
}
