{
  "multipart": [
    {
      "when": {
        "axis": "z"
      },
      "apply": {
        "model": "csm:buildingmaterials/acoustic/baffle_light_grey"
      }
    },
    {
      "when": {
        "axis": "z",
        "front": "false"
      },
      "apply": {
        "model": "csm:buildingmaterials/acoustic/baffle_end_light_grey"
      }
    },
    {
      "when": {
        "axis": "z",
        "back": "false"
      },
      "apply": {
        "model": "csm:buildingmaterials/acoustic/baffle_end_light_grey",
        "y": 180
      }
    },
    {
      "when": {
        "axis": "x"
      },
      "apply": {
        "model": "csm:buildingmaterials/acoustic/baffle_light_grey",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "x",
        "front": "false"
      },
      "apply": {
        "model": "csm:buildingmaterials/acoustic/baffle_end_light_grey",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "x",
        "back": "false"
      },
      "apply": {
        "model": "csm:buildingmaterials/acoustic/baffle_end_light_grey",
        "y": 270
      }
    },
    {
      "when": {
        "cable": "true"
      },
      "apply": {
        "model": "csm:buildingmaterials/acoustic/cable_baffle"
      }
    }
  ]
}
