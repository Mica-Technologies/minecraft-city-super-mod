{
  "multipart": [
    {
      "when": {
        "north": "none",
        "east": "none",
        "south": "none",
        "west": "none"
      },
      "apply": {
        "model": "csm:lifesafety/services/fire_line_tape_single"
      }
    },
    {
      "when": {
        "north": "tape|post"
      },
      "apply": {
        "model": "csm:lifesafety/services/fire_line_tape_arm"
      }
    },
    {
      "when": {
        "north": "post"
      },
      "apply": {
        "model": "csm:lifesafety/services/fire_line_tape_to_post"
      }
    },
    {
      "when": {
        "east": "tape|post"
      },
      "apply": {
        "model": "csm:lifesafety/services/fire_line_tape_arm",
        "y": 90
      }
    },
    {
      "when": {
        "east": "post"
      },
      "apply": {
        "model": "csm:lifesafety/services/fire_line_tape_to_post",
        "y": 90
      }
    },
    {
      "when": {
        "south": "tape|post"
      },
      "apply": {
        "model": "csm:lifesafety/services/fire_line_tape_arm",
        "y": 180
      }
    },
    {
      "when": {
        "south": "post"
      },
      "apply": {
        "model": "csm:lifesafety/services/fire_line_tape_to_post",
        "y": 180
      }
    },
    {
      "when": {
        "west": "tape|post"
      },
      "apply": {
        "model": "csm:lifesafety/services/fire_line_tape_arm",
        "y": 270
      }
    },
    {
      "when": {
        "west": "post"
      },
      "apply": {
        "model": "csm:lifesafety/services/fire_line_tape_to_post",
        "y": 270
      }
    }
  ]
}
