{
  "multipart": [
    {
      "when": {
        "north": "false",
        "east": "false",
        "south": "false",
        "west": "false"
      },
      "apply": {
        "model": "csm:lifesafety/services/fire_line_tape_single"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "csm:lifesafety/services/fire_line_tape_arm"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "csm:lifesafety/services/fire_line_tape_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "csm:lifesafety/services/fire_line_tape_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "csm:lifesafety/services/fire_line_tape_arm",
        "y": 270
      }
    }
  ]
}
