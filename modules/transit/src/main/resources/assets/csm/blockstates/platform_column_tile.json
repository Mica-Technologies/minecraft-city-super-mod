{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "csm:transit/platforms/platform_column_tile_shaft"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "csm:transit/platforms/platform_column_tile_shaft",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "csm:transit/platforms/platform_column_tile_shaft",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "csm:transit/platforms/platform_column_tile_shaft",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "down": "false"
      },
      "apply": {
        "model": "csm:transit/platforms/platform_column_tile_base"
      }
    },
    {
      "when": {
        "facing": "east",
        "down": "false"
      },
      "apply": {
        "model": "csm:transit/platforms/platform_column_tile_base",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "down": "false"
      },
      "apply": {
        "model": "csm:transit/platforms/platform_column_tile_base",
        "y": 180
