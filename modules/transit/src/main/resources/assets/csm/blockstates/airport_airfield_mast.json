{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "csm:transit/airside/airport_airfield_mast_shaft"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "csm:transit/airside/airport_airfield_mast_shaft",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "csm:transit/airside/airport_airfield_mast_shaft",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "csm:transit/airside/airport_airfield_mast_shaft",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "down": "false"
      },
      "apply": {
        "model": "csm:transit/airside/airport_airfield_mast_base"
      }
    },
    {
      "when": {
        "facing": "east",
        "down": "false"
      },
      "apply": {
        "model": "csm:transit/airside/airport_airfield_mast_base",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "down": "false"
      },
      "apply": {
        "model": "csm:transit/airside/airport_airfield_mast_base",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "down": "false"
      },
      "apply": {
        "model": "csm:transit/airside/airport_airfield_mast_base",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "up": "false"
      },
      "apply": {
        "model": "csm:transit/airside/airport_airfield_mast_cap"
      }
    },
    {
      "when": {
        "facing": "east",
        "up": "false"
      },
      "apply": {
        "model": "csm:transit/airside/airport_airfield_mast_cap",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "up": "false"
      },
      "apply": {
        "model": "csm:transit/airside/airport_airfield_mast_cap",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "up": "false"
      },
      "apply": {
        "model": "csm:transit/airside/airport_airfield_mast_cap",
        "y": 270
      }
    }
  ]
}
