{
  "multipart": [
    {
      "apply": {
        "model": "csm:transit/canopies/column/steel_shaft"
      }
    },
    {
      "when": {
        "base": "true"
      },
      "apply": {
        "model": "csm:transit/canopies/column/steel_base"
      }
    },
    {
      "when": {
        "cap": "true",
        "reach": "0"
      },
      "apply": {
        "model": "csm:transit/canopies/column/steel_cap"
      }
    },
    {
      "when": {
        "reach": "1"
      },
      "apply": {
        "model": "csm:transit/canopies/column/steel_cap_1"
      }
    },
    {
      "when": {
        "reach": "2"
      },
      "apply": {
        "model": "csm:transit/canopies/column/steel_cap_2"
      }
    },
    {
      "when": {
        "reach": "3"
      },
      "apply": {
        "model": "csm:transit/canopies/column/steel_cap_3"
      }
    },
    {
      "when": {
        "reach": "4"
      },
      "apply": {
        "model": "csm:transit/canopies/column/steel_cap_4"
      }
    },
    {
      "when": {
        "reach": "5"
      },
      "apply": {
        "model": "csm:transit/canopies/column/steel_cap_5"
      }
    },
    {
      "when": {
        "reach": "6"
      },
      "apply": {
        "model": "csm:transit/canopies/column/steel_cap_6"
      }
    }
  ]
}
