{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "csm:transit/airport/airport_divest_table_body"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "csm:transit/airport/airport_divest_table_body",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "csm:transit/airport/airport_divest_table_body",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "csm:transit/airport/airport_divest_table_body",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "left": "false"
      },
      "apply": {
        "model": "csm:transit/airport/airport_divest_table_end_left"
      }
    },
    {
      "when": {
        "facing": "east",
        "left": "false"
      },
      "apply": {
        "model": "csm:transit/airport/airport_divest_table_end_left",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "left": "false"
      },
      "apply": {
        "model": "csm:transit/airport/airport_divest_table_end_left",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "left": "false"
      },
      "apply": {
        "model": "csm:transit/airport/airport_divest_table_end_left",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "right": "false"
      },
      "apply": {
        "model": "csm:transit/airport/airport_divest_table_end_right"
      }
    },
    {
      "when": {
        "facing": "east",
        "right": "false"
      },
      "apply": {
        "model": "csm:transit/airport/airport_divest_table_end_right",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "right": "false"
      },
      "apply": {
        "model": "csm:transit/airport/airport_divest_table_end_right",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "right": "false"
      },
      "apply": {
        "model": "csm:transit/airport/airport_divest_table_end_right",
        "y": 270
      }
    }
  ]
}
