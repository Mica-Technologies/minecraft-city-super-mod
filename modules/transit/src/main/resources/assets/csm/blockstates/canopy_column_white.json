{
  "multipart": [
    {
      "apply": {
        "model": "csm:transit/canopies/column/white_shaft"
      }
    },
    {
      "when": {
        "base": "true"
      },
      "apply": {
        "model": "csm:transit/canopies/column/white_base"
      }
    },
    {
      "when": {
        "cap": "true"
      },
      "apply": {
        "model": "csm:transit/canopies/column/white_cap"
      }
    }
  ]
}
