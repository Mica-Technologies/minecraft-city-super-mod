{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "csm:streetscape/mailboxes/mailbox_curbside_white"
      }
    },
    {
      "when": {
        "facing": "north",
        "flag": "false"
      },
      "apply": {
        "model": "csm:streetscape/mailboxes/mailbox_curbside_white_flag_down"
      }
    },
    {
      "when": {
        "facing": "north",
        "flag": "true"
      },
      "apply": {
        "model": "csm:streetscape/mailboxes/mailbox_curbside_white_flag_up"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "csm:streetscape/mailboxes/mailbox_curbside_white",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "flag": "false"
      },
      "apply": {
        "model": "csm:streetscape/mailboxes/mailbox_curbside_white_flag_down",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "flag": "true"
      },
      "apply": {
        "model": "csm:streetscape/mailboxes/mailbox_curbside_white_flag_up",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "csm:streetscape/mailboxes/mailbox_curbside_white",
