{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "csm:utilities/meters/gas_meter_body"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "csm:utilities/meters/gas_meter_body",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "csm:utilities/meters/gas_meter_body",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "csm:utilities/meters/gas_meter_body",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "csm:utilities/meters/gas_meter_outlet"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "csm:utilities/meters/gas_meter_outlet",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "csm:utilities/meters/gas_meter_outlet",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "csm:utilities/meters/gas_meter_outlet",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "csm:utilities/meters/gas_meter_riser"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "csm:utilities/meters/gas_meter_riser",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "csm:utilities/meters/gas_meter_riser",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "csm:utilities/meters/gas_meter_riser",
        "y": 270
      }
    }
  ]
}
