{
  "multipart": [
    {
      "apply": {
        "model": "csm:utilities/sewer/hatch_collar"
      },
      "when": {
        "facing": "north"
      }
    },
    {
      "apply": {
        "model": "csm:utilities/sewer/hatch_collar",
        "y": 90
      },
