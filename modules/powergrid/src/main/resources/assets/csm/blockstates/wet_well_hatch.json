      },
      "when": {
        "facing": "south"
      }
    },
    {
      "apply": {
        "model": "csm:utilities/sewer/hatch_collar",
        "y": 270
      },
      "when": {
        "facing": "west"
      }
    },
    {
      "apply": {
        "model": "csm:utilities/sewer/hatch_leaf"
      },
      "when": {
        "facing": "north",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "csm:utilities/sewer/hatch_leaf",
        "y": 90
      },
      "when": {
