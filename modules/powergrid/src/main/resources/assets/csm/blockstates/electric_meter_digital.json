{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "csm:utilities/meters/meter_socket"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "csm:utilities/meters/meter_socket",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "csm:utilities/meters/meter_socket",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "csm:utilities/meters/meter_socket",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "csm:utilities/meters/meter_digital"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "csm:utilities/meters/meter_digital",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "csm:utilities/meters/meter_digital",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "csm:utilities/meters/meter_digital",
        "y": 270
      }
    }
  ]
}
