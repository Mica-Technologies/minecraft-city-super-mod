{
  "multipart": [
    {
      "when": {
        "upper": "false",
        "facing": "north"
      },
      "apply": {
        "model": "csm:furniture/residential/shower_enclosure_chrome_lower"
      }
    },
    {
      "when": {
        "upper": "true",
        "facing": "north"
      },
      "apply": {
        "model": "csm:furniture/residential/shower_enclosure_chrome_upper"
      }
