{
  "multipart": [
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "csm:signage/billboard_service"
      }
    },
    {
      "when": {
        "facing": "south",
        "left": "false"
      },
      "apply": {
        "model": "csm:signage/billboard_rail_left"
      }
    },
    {
      "when": {
        "facing": "south",
        "right": "false"
      },
      "apply": {
        "model": "csm:signage/billboard_rail_right"
      }
    },
    {
      "when": {
        "facing": "south",
        "lamp": "true"
      },
      "apply": {
        "model": "csm:signage/billboard_lamp"
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "csm:signage/billboard_service",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "west",
        "left": "false"
      },
      "apply": {
        "model": "csm:signage/billboard_rail_left",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "west",
        "right": "false"
      },
      "apply": {
        "model": "csm:signage/billboard_rail_right",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "west",
        "lamp": "true"
      },
      "apply": {
        "model": "csm:signage/billboard_lamp",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "csm:signage/billboard_service",
