{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "on": "true"
      },
      "apply": {
        "model": "csm:venues/concourse/hot_dog_roller_grill_on"
      }
    },
    {
      "when": {
        "facing": "north",
        "on": "false"
      },
      "apply": {
        "model": "csm:venues/concourse/hot_dog_roller_grill_off"
      }
    },
    {
      "when": {
        "facing": "east",
        "on": "true"
      },
      "apply": {
        "model": "csm:venues/concourse/hot_dog_roller_grill_on",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "on": "false"
      },
      "apply": {
        "model": "csm:venues/concourse/hot_dog_roller_grill_off",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "on": "true"
      },
      "apply": {
        "model": "csm:venues/concourse/hot_dog_roller_grill_on",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "on": "false"
      },
      "apply": {
        "model": "csm:venues/concourse/hot_dog_roller_grill_off",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "on": "true"
      },
      "apply": {
        "model": "csm:venues/concourse/hot_dog_roller_grill_on",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "on": "false"
      },
      "apply": {
        "model": "csm:venues/concourse/hot_dog_roller_grill_off",
        "y": 270
      }
    }
  ]
}
