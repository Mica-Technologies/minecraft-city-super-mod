{
  "multipart": [
    {
      "apply": {
        "model": "csm:venues/av/catwalk_floor"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "csm:venues/av/catwalk_rail"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "csm:venues/av/catwalk_rail",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "csm:venues/av/catwalk_rail",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "csm:venues/av/catwalk_rail",
        "y": 270
      }
    }
  ]
}
