{
  "multipart": [
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "csm:venues/golf/minigolf_border_north"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "csm:venues/golf/minigolf_border_north",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "csm:venues/golf/minigolf_border_north",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "csm:venues/golf/minigolf_border_north",
        "y": 270
      }
    }
  ]
}
