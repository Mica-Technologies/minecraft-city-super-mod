server-smoke.log
.claude/settings.local.json
.claude/worktrees/
dev-env-utils/target/

# npm dependencies for the i18n tooling (dev-env-utils/i18n)
node_modules/
assets/docs/agent_progress/
.rosetta-natives/

# macOS Finder metadata
.DS_Store

# MkDocs build output. The site is built by CI from docs/; this is only ever local.
/site/

# Python bytecode from the dev-env-utils scripts.
dev-env-utils/scripts/__pycache__/

# Scratch output from the dev-env-utils asset generators (--scratch / --check).
dev-env-utils/scripts/_*_out/
